# 4) SERVER
##############################################################
server <- function(input, output, session) {
  
  # [AJOUT] Champ de hauteur dynamique selon le tarif choisi (en dehors du calcul)
  output$h_ui <- renderUI({
    if (identical(input$tarif_uni, "tarif1")) return(NULL)                         # pas de H pour tarif1
    if (identical(input$tarif_uni, "tarif2")) {
      return(textInput("H_uni", "Hauteur dominante (Hdom) en m", value = "20"))   # libellé Hdom pour tarif2
    }
    textInput("H_uni", "Hauteur totale (m)", value = "20")                         # sinon H totale
  })
  
  # 4.1) Calcul ARBRE UNIQUE ---------------------------------
  calc_res_uni <- eventReactive(input$calc_uni, {
    f  <- get(input$tarif_uni, envir = asNamespace("dagnelie"))
    mp <- detect_mapping(f)  # noms réels des arguments
    
    # Saisies
    C130_v    <- parse_vector(input$C130_uni)
    H_v_input <- parse_vector(input$H_uni)
    sp_v_raw  <- if (nzchar(input$species_uni)) trimws(input$species_uni) else NULL
    
    # Validation de base
    validate(need(!is.null(C130_v), "C130 manquant."))
    validate(need(has_name(mp$circ), paste0("Ce tarif n’a pas d’argument de circonférence reconnu (trouvé: ", paste(mp$all, collapse=", "), ").")))
    
    # ----
    #   # [AJOUT] Validation de H selon le tarif
    #   if (has_name(mp$h)) {
    #     validate(need(!is.null(H_v_input),
    #                   if (identical(input$tarif_uni, "tarif2"))
    #                     "Hdom requise pour ce tarif (Hauteur dominante)."
    #                   else
    #                     "Hauteur requise pour ce tarif."
    #     ))
    #   }
    # ----
    # [AJOUT] Validation de H selon le tarif (version active)
    if (has_name(mp$h)) {
      validate(need(!is.null(H_v_input),
                    if (identical(input$tarif_uni, "tarif2"))
                      "Hdom requise pour ce tarif (Hauteur dominante)."
                    else
                      "Hauteur requise pour ce tarif."
      ))
    }
    
    # H n'est requise que si la fonction A effectivement un paramètre de hauteur
    #if (has_name(mp$h)) {
    #  validate(need(!is.null(H_v_input), "Hauteur requise pour ce tarif (paramètre de hauteur détecté)."))
    #}
    # ----
    
    # speciesCode requis uniquement si la fonction a un paramètre 'espèce'
    if (has_name(mp$sp)) {
      validate(need(!is.null(sp_v_raw), "speciesCode requis pour ce tarif."))
      validate(need(!(sp_v_raw %in% aggregate_codes),
                    paste0("Le code '", sp_v_raw, "' est une catégorie agrégée et n’est pas accepté pour les calculs unitaires.")))
    } else {
      sp_v_raw <- NULL
    }
    
    # Harmonisation longueurs
    n <- max(length(C130_v), if (has_name(mp$h)) length(H_v_input) else 1, if (!is.null(sp_v_raw)) 1 else 1)
    C130_v <- recycle_to(C130_v, n)
    if (has_name(mp$h)) H_v <- recycle_to(H_v_input, n) else H_v <- rep(NA, n)
    sp_v <- if (!is.null(sp_v_raw)) rep(sp_v_raw, n) else rep(NA_character_, n)
    
    # Checks numériques simples
    validate(need(all(is.numeric(C130_v)), "C130 doit être numérique (ou liste de nombres)."))
    if (has_name(mp$h)) {
      validate(need(all(is.numeric(H_v)), "H doit être numérique (ou liste de nombres)."))
      validate(need(all(H_v > 0, na.rm = TRUE), "H doit être > 0."))
    }
    validate(need(all(C130_v > 0), "C130 doit être > 0."))
    
    # Calcul ligne à ligne
    vols <- numeric(n); msgs <- character(n)
    for (i in seq_len(n)) {
      args_i <- list()
      if (has_name(mp$circ)) args_i[[mp$circ]] <- as.numeric(C130_v[i])
      if (has_name(mp$h)    && !is.na(H_v[i])) args_i[[mp$h]]    <- as.numeric(H_v[i])
      if (has_name(mp$sp)   && !is.na(sp_v[i])) {
        sval <- as.character(sp_v[i])
        if (grepl("^[0-9]+$", sval)) sval <- as.numeric(sval)
        args_i[[mp$sp]] <- sval   # speciesCode prioritaire si présent
      }
      
      res_i <- tryCatch(do.call(f, args_i), error = function(e) e)
      if (inherits(res_i, "error")) {
        vols[i] <- NA_real_; msgs[i] <- conditionMessage(res_i)
      } else {
        vols[i] <- suppressWarnings(as.numeric(res_i))[1]
        msgs[i] <- if (is.na(vols[i])) "Résultat non-numérique" else "OK"
      }
    }
    
    #    data.frame(
    #      C130        = C130_v,
    #      H           = if (has_name(mp$h)) H_v else NA,
    #      
    #      speciesCode = if (has_name(mp$sp)) sp_v else NA,
    #      volume      = vols,
    #      statut      = msgs,
    #      check.names = FALSE
    #    )
    # ----
    #   # [AJOUT] data.frame corrigé (version finale)
    data.frame(
      C130        = C130_v,
      H           = if (has_name(mp$h)) H_v else NA,
      speciesCode = if (has_name(mp$sp)) sp_v else NA,
      volume      = vols,
      statut      = msgs,
      check.names = FALSE
    )
  }, ignoreInit = TRUE)
  #     ---------------------------------
  
  #  ---------------------------
  output$result_table_uni <- renderTable({ req(calc_res_uni()); calc_res_uni() })
  output$result_msg_uni <- renderPrint({
    req(calc_res_uni())
    ok <- sum(calc_res_uni()$statut == "OK"); n <- nrow(calc_res_uni())
    if (ok == n) cat("✅ Calcul réussi.") else cat("⚠️", n - ok, "ligne(s) en erreur. Voir 'statut'.")
  })
  output$appel_uni <- renderText({
    req(calc_res_uni())
    df <- calc_res_uni()[1, ]
    # On reconstruit un appel "propre" avec seulement les arguments existants
    parts <- c(paste0("C130=", df$C130[1]))
    # if (!is.na(df$H[1])) parts <- c(parts, paste0("H=", df$H[1]))
    # [AJOUT] Affiche "Hdom" si tarif2, sinon "H"
    if (!is.na(df$H[1])) {
      parts <- c(parts, paste0(if (identical(input$tarif_uni, "tarif2")) "Hdom" else "H", "=", df$H[1]))
    }
    if (!is.na(df$speciesCode[1])) {
      sc <- as.character(df$speciesCode[1])
      parts <- c(parts, paste0("speciesCode=", if (grepl("^[0-9]+$", sc)) sc else paste0("'", sc, "'")))
    }
    paste0(input$tarif_uni, "(", paste(parts, collapse = ", "), ")")
  })
  output$help_uni <- renderUI({
    txt <- tryCatch(paste(capture.output(utils::help(input$tarif_uni, package = "dagnelie")), collapse = "\n"),
                    error = function(e) "Aide indisponible.")
    tags$details(tags$summary(paste0("Afficher l’aide de ", input$tarif_uni)), tags$pre(txt))
  })
  
  # 4.2) Import & mapping (JEU DE DONNÉES) -------------------
  dat_raw <- reactive({
    req(input$file_up)
    ext <- tools::file_ext(input$file_up$name)
    read_table_any(input$file_up$datapath, ext = ext, sep_choice = input$sep_choice)
  })
  output$preview <- renderTable({ req(dat_raw()); head(dat_raw(), 10) })
  
  output$mapping_ui <- renderUI({
    req(dat_raw())
    cols <- names(dat_raw())
    tagList(
      selectInput("col_tarif", "Colonne du tarif (ou fixe)", choices = c("<fixe>", cols), selected = "<fixe>"),
      conditionalPanel(
        condition = "input.col_tarif == '<fixe>'",
        selectInput("tarif_fix", "Tarif fixe :", choices = c("tarif1","tarif2","tarif3","tarif4"), selected = "tarif1")
      ),
      selectInput("col_C130", "Colonne C130 (cm) :", choices = cols),
      selectInput("col_H",    "Colonne H (m) :", choices = c("", cols), selected = ""),
      selectInput("col_species", "Colonne speciesCode :", choices = c("", cols), selected = "")
    )
  })
  
  # 4.3) Calcul batch ----------------------------------------
  calc_res_batch <- eventReactive(input$calc_batch, {
    df <- dat_raw()
    validate(need(!is.null(input$col_C130) && nzchar(input$col_C130), "Sélectionne la colonne C130."))
    tarif_vec  <- if (input$col_tarif == "<fixe>") rep(input$tarif_fix, nrow(df)) else as.character(df[[input$col_tarif]])
    C130_vec   <- df[[input$col_C130]]
    H_vec      <- if (nzchar(input$col_H)) df[[input$col_H]] else rep(NA, nrow(df))
    species_vec<- if (nzchar(input$col_species)) as.character(df[[input$col_species]]) else rep(NA_character_, nrow(df))
    
    # Détection & calcul par ligne
    out <- vector("list", nrow(df))
    for (i in seq_len(nrow(df))) {
      tarif_i <- as.character(tarif_vec[i])
      f <- tryCatch(get(tarif_i, envir = asNamespace("dagnelie")), error = function(e) NULL)
      if (is.null(f)) { out[[i]] <- list(volume = NA, statut = paste0("Tarif inconnu: ", tarif_i)); next }
      mp <- detect_mapping(f)
      
      args_i <- list()
      if (has_name(mp$circ)) args_i[[mp$circ]] <- as.numeric(C130_vec[i])
      if (has_name(mp$h) && !is.na(H_vec[i])) args_i[[mp$h]] <- as.numeric(H_vec[i])
      
      if (has_name(mp$sp) && !is.na(species_vec[i]) && nzchar(species_vec[i])) {
        # blocage des catégories agrégées
        if (species_vec[i] %in% aggregate_codes) {
          out[[i]] <- list(volume = NA, statut = paste0("speciesCode agrégé non accepté: ", species_vec[i])); next
        }
        sval <- species_vec[i]
        if (grepl("^[0-9]+$", sval)) sval <- as.numeric(sval)
        args_i[[mp$sp]] <- sval
      }
      
      res_i <- tryCatch(do.call(f, args_i), error = function(e) e)
      if (inherits(res_i, "error")) {
        out[[i]] <- list(volume = NA_real_, statut = conditionMessage(res_i))
      } else {
        v <- suppressWarnings(as.numeric(res_i))[1]
        out[[i]] <- list(volume = v, statut = if (is.na(v)) "Résultat non-numérique" else "OK")
      }
    }
    
    data.frame(
      tarif       = tarif_vec,
      C130        = C130_vec,
      H           = if (nzchar(input$col_H)) H_vec else NA,
      speciesCode = species_vec,
      volume      = sapply(out, `[[`, "volume"),
      statut      = sapply(out, `[[`, "statut"),
      check.names = FALSE
    )
  }, ignoreInit = TRUE)
  
  output$result_table_batch <- renderTable({ req(calc_res_batch()); head(calc_res_batch(), 50) })
  output$result_msg_batch <- renderPrint({
    req(calc_res_batch())
    ok <- sum(calc_res_batch()$statut == "OK"); n <- nrow(calc_res_batch())
    cat("Lignes OK :", ok, "/", n, " | Lignes en erreur :", n - ok, "\n")
    if (any(calc_res_batch()$statut != "OK")) cat("⚠️ Voir la colonne 'statut' pour le détail.")
  })
  
  # 4.4) Téléchargements -------------------------------------
  output$dl_template_xlsx <- downloadHandler(
    filename = function() "template_cubage.xlsx",
    content = function(file) {
      tpl <- data.frame(
        tarif       = c("tarif1","tarif2","tarif3"),
        C130        = c(100, 120, 110),
        H           = c(NA,  20,  25),   # H si le tarif la demande
        speciesCode = c("3","41","3"),   # Hêtre, Épicéa commun, Hêtre (exemples)
        stringsAsFactors = FALSE
      )
      writexl::write_xlsx(tpl, path = file)
    }
  )
  
  output$dl_results <- downloadHandler(
    filename = function() "resultats_cubage.csv",
    content = function(file) {
      req(calc_res_batch())
      write.csv(calc_res_batch(), file, row.names = FALSE, fileEncoding = "UTF-8")
    }
  )
  
  # 4.5) Codes essences (table fournie) -----------------------
  output$codes_table <- renderTable({
    species_codes
  })
}

##############################################################
# 5) LANCEMENT
##############################################################
shinyApp(ui = ui, server = server)
